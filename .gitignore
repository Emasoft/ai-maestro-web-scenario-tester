# Janitor per-session detector state + logs — regeneratable, never committed
/.janitor/
.DS_Store
node_modules/
.venv/
__pycache__/
*.pyc
# Sentinel that arms the plugin's PreToolUse write-guard during a scenario run
# (the run owner writes it at run start, deletes it at run end). Never committed.
.claude/scenario_is_running.json

# Added by CPV standardize
.claude/
.tldr/
llm_externalizer_output/
*_dev/
.env
dist/
build/
.coverage
.pytest_cache/
.ruff_cache/

# Private classes the plain `.env` line above does not cover. A scenario run
# writes credentials into per-env dotenv variants and drops logs in the tree,
# so these are live leak paths, not hypotheticals.
.env.*
id_rsa*
*.pem
*.key
*.log
# /janitor-safe-delete staging — recoverable copies of deleted work, never committed
.trashcan/
